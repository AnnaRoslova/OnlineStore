@model Product
<form method="post">
    <input type="hidden" name="id" value="@Model?.Id" />
    <div class="row">
        <div class="col-6">
            <label>Название:</label>
            <input class="form-control" type="text" name="name" value="@Model?.Name"/>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Описание:</label>
            <input class="form-control" type="text" name="description" value="@Model?.Description"/>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Стоимость:</label>
            <input class="form-control" type="text" name="cost" value="@Model?.Cost" />
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>цвет:</label>
            <input class="form-control" type="text" name="color" value="@Model?.Color"/>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Производитель:</label>
            <input class="form-control" type="text" name="compound" value="@Model?.Compound"/>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Материал:</label>
            <input class="form-control" type="text" name="manufactured" value="@Model?.Manufactured"/>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Изображение товара:</label>
            <input class="form-control" type="text" name="ImagePath" value="/images/2749271.png" />
        </div>
    </div>
    <div>
        <button type="submit" asp-controller="Admin" asp-action="Edit">Сохранить</button>
    </div>
</form>