@model Product
<form method="post">
    <div class="row">
        <div class="col-6">
            <label>Название:</label>
            <input class="form-control" type="text" name="name" />
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Описание:</label>
            <input class="form-control" type="text" name="description" />
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Стоимость:</label>
            <input class="form-control" type="text" name="cost"/>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>цвет:</label>
            <input class="form-control" type="text" name="color" />
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Производитель:</label>
            <input class="form-control" type="text" name="compound" />
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Материал:</label>
            <input class="form-control" type="text" name="manufactured" />
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Изображение товара:</label>
            <input class="form-control" type="text" name="ImagePath" value="/images/2749271.png" />
        </div>
    </div>
    <div>
        <button type="submit" asp-controller="Admin" asp-action="AddProduct">Сохранить</button>
    </div>
</form>