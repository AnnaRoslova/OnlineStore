<header class="d-flex justify-content-center">
    <nav class="navbar navbar-expand-lg navbar-light row container">
        <a class="navbar-brand col-4" asp-area="User" asp-controller="Home" asp-action="Index">
            <img src="~/images/brand.png" width="30" height="30" class="d-inline-block align-top" alt="">
            four paws
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse d-flex  justify-content-end" id="navbarSupportedContent">
           
            <ul class="navbar-nav  my-2 my-lg-0 col-8 d-flex justify-content-end">
                <li class="nav-item active">
                    <form method="post">
                        <div class="btn-group">
                            <input class="form-control" placeholder="Поиск" name="request" />
                            <button class="btn" type="submit" asp-controller="Home" asp-action="Search"><img src="~/images/loupe.png" width="30" height="30"/></button>
                        </div>
                    </form>
                </li>
                <li class="nav-item active">
                    HHHHHHH
                </li>
                @if(User.Identity.IsAuthenticated)
                {
                    <li class="nav-item text-dark">  
                        @User.Identity.Name
                    </li>
                    <li class="nav-item">  
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">Выход</a>
                    </li>
                }
                else
                {
                    <li class="nav-item"> 
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Вход</a>
                    </li>
                }
                @if(User.IsInRole(Constants.AdminRoleName))
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="Admin" asp-controller="Account" asp-action="Index">Администратор</a>
                    </li>
                }
                <li class="nav-item active">
                    <a class="nav-link" asp-area="Admin" asp-controller="Order" asp-action="Index"><img src="~/images/admin.png" width="30" height="30"/> <span class="sr-only">(current)</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="User" asp-controller="Compare" asp-action="Index"><img src="~/images/compare.png" width="30" height="30" class="d-inline-block align-top" alt=""></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="User" asp-controller="WishList" asp-action="Index"><img src="~/images/wishlist.png" width="30" height="30" class="d-inline-block align-top" alt=""></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="User" asp-controller="Account" asp-action="Login"><img src="~/images/account.png" width="30" height="30" class="d-inline-block align-top" alt=""></a>
                </li>
                <li class="nav-item">
                    @await Component.InvokeAsync("Cart")
                </li>
            </ul>
        </div>
    </nav>
</header>