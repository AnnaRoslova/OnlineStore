<header class="row justify-content-center">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand col-4 justify-content-start" asp-area="" asp-controller="Home" asp-action="Index">Four paws</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="container navbar-collapse collapse d-sm-inline-flex justify-content-end">
                <ul class="navbar-nav mr-auto col-8 justify-content-end">

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Вход</a>
                    </li>
                    <li class="nav-item ">
                        <a class="nav-link text-dark" asp-area="Admin" asp-controller="Order" asp-action="Index">Администратор</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark navbar-brand" asp-area="" asp-controller="Compare" asp-action="Index"><img class="img-fluid navbar-brand" src="~/images/compare.png" /></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark navbar-brand" asp-area="" asp-controller="WishList" asp-action="Index"><img class="img-fluid navbar-brand" src="~/images/wishlist.png" /></a>
                    </li>
                    <li class="nav-item">
                        @await Component.InvokeAsync("Cart")
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>