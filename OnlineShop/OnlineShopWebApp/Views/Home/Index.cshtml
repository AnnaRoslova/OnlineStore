@model List<Product>
@{
    ViewData["Title"] = "Home Page";
}
<div class="row">
    @foreach (var produrt in Model)
    {
    <div class="col-3 card shadow">
        <img class="imgStyle" src="@produrt.ImagePath"  alt="изображение товара"/>
        <div class="card-body">
            <a class="TextStyle" href="/product/index/@produrt.Id">
                <h5>@produrt.Name</h5>
                <h5>@produrt.Cost руб</h5>
            </a>
            <a class="btn btn-primary shadow" href="/cart/add?productId=@produrt.Id" role="button">Добавить в корзину</a>
            <a class="btn btn-primary shadow" href="/compare/add?productId=@produrt.Id" role="button">Сравнить</a>
        </div>
    </div>     
    }
</div>
<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://docs.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
