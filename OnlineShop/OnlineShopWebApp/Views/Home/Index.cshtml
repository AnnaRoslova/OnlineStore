@model List<Product>
@{
    ViewData["Title"] = "My Store";
}
    <div id="carouselExampleIndicators" class="carousel slide w-100 h-100 bg-light" data-ride="carousel">
        <ol class="carousel-indicators">
            <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="carousel-img" src="/images/catanddog.png" alt="Первый слайд">
                <a href="#" class="carousel-img">Каталог</a>
            </div>
            <div class="carousel-item">
                <img class="carousel-img" src="/images/catanddog.png" alt="Второй слайд">
                <a href="#" class="carousel-img">Каталог</a>
            </div>
            <div class="carousel-item">
                <img class="carousel-img" src="/images/catanddog.png" alt="Третий слайд">
                <a href="#" class="carousel-img">Каталог</a>
            </div>
        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
    <form method="post">
        <div class="btn-group">
            <input class="form-control" placeholder="Поиск" name="request" />
            <button class="btn-outline-primary" type="submit" asp-controller="Home" asp-action="Search">найти</button>
        </div>
    </form>
    <div class="row">

        @foreach (var produrt in Model)
        {
            <div class="col-3 card shadow">
                <img class="imgStyle" src="@produrt.ImagePath" alt="изображение товара" />
                <div class="card-body">
                    <a class="TextStyle"
                       asp-area=""
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-id="@produrt.Id">
                        <h5>@produrt.Name</h5>
                        <h5>@produrt.Cost руб</h5>
                    </a>
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="cart" asp-action="Add" asp-route-productId="@produrt.Id" role="button">Добавить в корзину</a>
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="Compare" asp-action="Add" asp-route-productId="@produrt.Id" role="button">Сравнить</a>
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="WishList" asp-action="Add" asp-route-productId="@produrt.Id" role="button">В избранное</a>
                </div>
            </div>
        }
    </div>