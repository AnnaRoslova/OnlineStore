@model List<User>
<div class="row">
    @await Html.PartialAsync("AdminLeftMenu")
    <div class="col-9">
        <table class="table">
            <thead>
                <tr>
                    <th>Имя пользователя</th>
                    <th>Номер телефона</th>
                    <th>E-mail</th>
                </tr>
            </thead>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Detail"
                           asp-route-name="@user.UserName">@user.UserName</a>
                    </td>
                    <td>@user.Phone</td>
                    <td>@user.Email</td>
                </tr>
            }
            <tr>
                <td></td>
                <td></td>
                <td>
                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Add">добавить пользователя</a>
                </td>
            </tr>
        </table>
    </div>
</div>