@model ChangePassword
<form method="post">
    <input type="hidden" name="UserName" value="@Model.UserName" />
    <div class="row">
        <div class="row">
            <div class="col-6">
                <label asp-for="CurrentPassword">Введите старый пароль:</label>
                <input class="form-control" asp-for="CurrentPassword" name="CurrentPassword" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>
        </div>
        <div asp-validation-summary="All">
            <div class="col-6">
                <label asp-for="Password">Название:</label>
                <input class="form-control" asp-for="Password"/>
                <span asp-validation-for="Password  "></span>
            </div>
        </div>
        <div class="row">
            <div class="col-6">
                <label asp-for="ConfirmPassword">Повторите пароль:</label>
                <input class="form-control" asp-for="ConfirmPassword" name="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
    </div>
    <div>
        <button type="submit" asp-area="Admin" asp-controller="User" asp-action="ChangePassword">Сохранить</button>
    </div>
</form>