@model ProductViewModel
<form method="post" enctype="multipart/form-data">
    <input type="hidden" name="id" value="@Model?.Id" />
    <div class="row">
        <div asp-validation-summary="All">
        <div class="col-6">
            <label asp-for="Name">Название:</label>
            <input class="form-control" type="text" asp-for="Name" name="name" value="@Model?.Name"/>
            <span asp-validation-for="Name"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Description">Описание:</label>
            <input class="form-control" type="text" asp-for="Description" name="description" value="@Model?.Description"/>
            <span asp-validation-for="Description"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Cost">Стоимость:</label>
            <input class="form-control" type="text" asp-for="Cost" name="cost" value="@Model?.Cost" />
            <span asp-validation-for="Cost"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Color">цвет:</label>
            <input class="form-control" type="text" asp-for="Color" name="color" value="@Model?.Color"/>
            <span asp-validation-for="Color"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Compound">Производитель:</label>
            <input class="form-control" type="text" asp-for="Compound" name="compound" value="@Model?.Compound"/>
            <span asp-validation-for="Compound"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Manufactured">Материал:</label>
            <input class="form-control" type="text" asp-for="Manufactured" name="manufactured" value="@Model?.Manufactured"/>
            <span asp-validation-for="Manufactured"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Загрузить изображение</label>
            <input class="form-control" type="file" name="UploadedImage"/>
        </div>
    </div>

        </div>
    <div>
        <button type="submit" asp-area="Admin" asp-controller="Product" asp-action="Edit">Сохранить</button>
    </div>
</form>