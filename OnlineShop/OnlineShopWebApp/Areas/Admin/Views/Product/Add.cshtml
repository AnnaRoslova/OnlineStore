@model ProductViewModel
<form method="post">
    <div asp-validation-summary="All">
    <div class="row">
        <div class="col-6">
            <label asp-for="Name">Название:</label>
            <input class="form-control" type="text" asp-for="Name" name="name" />
            <span asp-validation-for="Name"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Description">Описание:</label>
            <input class="form-control" type="text" asp-for="Description" name="description" />
            <span asp-validation-for="Description"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Cost">Стоимость:</label>
            <input class="form-control" type="text" asp-for="Cost" name="cost"/>
            <span  asp-validation-for="Cost"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Color">цвет:</label>
            <input class="form-control" type="text" asp-for="Color" name="color" />
            <span asp-validation-for="Color"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Compound">Производитель:</label>
            <input class="form-control" type="text" asp-for="Compound" name="compound" />
            <span asp-validation-for="Compound"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label asp-for="Manufactured">Материал:</label>
            <input class="form-control" type="text" asp-for="Manufactured" name="manufactured" />
            <span asp-validation-for="Manufactured"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <label>Изображение товара:</label>
            <input class="form-control" type="text" name="ImagePath" value="/images/2749271.png" />
        </div>
    </div>
        </div>
    <div>
        <button type="submit" asp-area="Admin" asp-controller="Product" asp-action="Add">Сохранить</button>
    </div>
</form>