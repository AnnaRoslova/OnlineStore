@model OrderViewModel
<form method="post">
<div class="row">
    @await Html.PartialAsync("AdminLeftMenu")
    <div class="col-9">
        <table class="table">
            <tr>
                <td>Дата и время</td>
                <td>@Model.CreateDateTime.ToString("g")</td>
            </tr>
            <tr>
                <td>Адрес доставки</td>
                <td>@Model.User.Address</td>
            </tr>
            <tr>
                <td>Получатель</td>
                <td>@Model.User.Name</td>
            </tr>
            <tr>
                <td>Телефон</td>
                <td>@Model.User.Phone</td>
            </tr>
            <tr>
                <td>Сумма заказа</td>
                <td>@Model.Cost</td>
            </tr>
            <tr>
                <td>Статус заказа</td>
                <td>
                    <select 
                            asp-for="@Model.Statuses"
                            asp-items="@Html.GetEnumSelectList<OrderStatusesViewModel>()"
                            class="form-control">
                    </select>
                </td>
            </tr>
        </table>
    </div>
    <button class="btn btn-primary" type="submit" asp-area="Admin" asp-controller="Order" asp-action="UpdateOrderStatus" asp-route-orderId="@Model.Id">Сохранить</button>
</div> 
</form>