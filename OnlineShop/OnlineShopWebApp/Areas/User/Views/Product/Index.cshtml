@model ProductViewModel
@{
    ViewData["Title"] = "Index";
}
<div class="row">
    <div class="col-4 card shadow">
        <div class="card-body">
            <img class="card-img-top" src="@Model.ImagePath" />
            <h5>@Model.Name</h5>
            <h5>@Model.Cost руб</h5>
            <p>Цвет: @Model.Color</p>
            <p>Материал: @Model.Compound руб</p>
            <p>Производитель: @Model.Manufactured</p>
            <p>Описание: @Model.Description </p>
            <p>Описание: @Model.Id</p>
            <div>
                <a class="btn btn-outline-primary" href="/cart/add?productId=@Model.Id" role="button">Добавить в корзину</a>
            </div>
            <br />
            <div>
                <a class="btn btn-outline-primary" href="/home/index" role="button">Продолжить покупки</a>
            </div>
        </div>
    </div>
</div>